[Unit]
Description=Mobile Terminal profile proxy (Powerhouse + Behuman stub) + passkeys
Documentation=file:///home/powerhouse/mobile-terminal/ps-proxy-up.sh
Wants=network-online.target
After=network-online.target
# Never let the plain standalone backend and the proxy fight over :8085.
Conflicts=mobile-terminal.service

[Service]
Type=simple
WorkingDirectory=/home/powerhouse/mobile-terminal
UMask=0077
ExecStartPre=/usr/bin/test -x /home/powerhouse/mobile-terminal/ps-proxy-up.sh
ExecStart=/home/powerhouse/mobile-terminal/ps-proxy-up.sh --apply
Restart=always
RestartSec=3
TimeoutStopSec=15
# process (not control-group): stopping the proxy must NOT kill tmux servers or
# shells that were spawned under the backend cgroup. The script's own trap reaps
# the two python processes on SIGTERM.
KillMode=process
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
